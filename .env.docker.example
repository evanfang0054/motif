# Motif Docker 部署配置模板
#
#   cp .env.docker.example .env   &&   编辑 .env 填好下面两项   &&   docker compose up -d
#
# 本文件就是容器配置的**唯一入口**：`docker-compose.yml` 用 `env_file` 把它原样注入容器 ——
# 写了才注入、没写的不注入（改完要 `docker compose up -d` 重建容器才会生效）。
#
# ⚠️ 以下键由 compose 钉死，**不要写在这里**（写了会被 compose 的 `environment` 覆盖，不生效）：
#    MOTIF_DATA_DIR / MOTIF_DB_FILE（数据位置必须与挂载点一致）、NODE_ENV（生产标记）。
# ⚠️ 值里的**字面 `$` 要写成 `$$`**：compose 会对本文件做变量插值 ——
#    实测 `SMTP_PASS=abc$def` 到容器里只剩 `abc`，`abc$$def` 才是 `abc$def`。
#    密码/密钥里带 `$` 时尤其注意（SMTP_PASS、S3_SECRET_ACCESS_KEY、渠道密钥…）。
# ⚠️ 同一个键别写两遍：compose 取最后一条，前一条会被静默忽略。
#
# ⚠️ 但这些值只在**首次启动**时播种进数据库（settings 表），之后改这里不再生效 ——
#    要改请走「管理后台 → 系统设置」（保存即热生效，无需重启）。
#    例外：上面钉死的几个键由 compose 固定，引导类参数只认环境变量。
# ⚠️ 本文件是模板，不要在这里写真实密钥后提交（`.env` 已被 .gitignore / .dockerignore 排除）。

# —— 必需：你的 OpenAI 兼容生图网关 ——
# 例：https://api.openai.com/v1、自建网关 http://gateway:3000/v1
IMAGE_API_BASE_URL=
# 网关令牌（形如 sk-...）
IMAGE_API_KEY=
# 模型名，默认 gpt-image-2
# IMAGE_MODEL=gpt-image-2

# —— 推荐：站点对外地址（支付回调 / 支付跳转 / 找回密码邮件直达链接都要它）——
# SITE_URL=https://motif.example.com

# —— HTTPS 部署时开启 ——
# MOTIF_COOKIE_SECURE=1

# —— 图片存储切 S3 / MinIO（默认 local）——
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=motif
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=

# —— 队列 worker：默认进程内跑（单容器最简单）。要多进程分担就关掉它、另起一个独立 worker ——
# MOTIF_INPROC_WORKER=false

# —— 提示词增强（可选，需同时配端点与密钥才生效）——
# LLM_ENHANCE_ENABLED=true
# LLM_API_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=sk-...

# —— 邮件发信（默认 console：验证码打进容器日志）——
# MOTIF_MAILER=smtp
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# —— 仅本地联调：注册验证码随接口直出。生产务必保持注释 ——
# MOTIF_EXPOSE_DEV_CODE=1
