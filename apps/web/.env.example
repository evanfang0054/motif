# ============================================================
# 说明：下面这些配置在**首次启动时会被播种进数据库**（settings 表）。
# 播种之后以数据库为唯一真相 —— 想改配置请用管理后台「系统设置」，
# 再改这里的值不会覆盖已播种的项。
#
# 例外（只能在环境变量里改，管理后台只读展示）：
#   MOTIF_DATA_DIR / MOTIF_DB_FILE —— 它们决定数据库自身的位置
#   MOTIF_ADMIN_EMAIL / MOTIF_ADMIN_PASSWORD / MOTIF_SKIP_ADMIN_BOOTSTRAP —— 引导参数
# ============================================================

# ========== 生图网关（OpenAI 兼容，必需） ==========
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# ========== 验证码发信（MOTIF_MAILER=console 默认本地直出） ==========
# console | smtp | resend | sendgrid
MOTIF_MAILER=console
# smtp 渠道（如 QQ 邮箱：smtp.qq.com + 465 + 授权码）
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# resend 渠道
RESEND_API_KEY=
# sendgrid 渠道
SENDGRID_API_KEY=

# ========== 数据位置（只能在环境变量里改，管理后台只读展示） ==========
# MOTIF_DATA_DIR=
# MOTIF_DB_FILE=

# ========== 本地联调：注册验证码直出（生产不要开启） ==========
MOTIF_EXPOSE_DEV_CODE=

# ========== 会话 Cookie 的 Secure 标记（HTTPS 部署时设 1） ==========
# MOTIF_COOKIE_SECURE=

# ========== 支付渠道：mock（默认，演示收银台）| epay | stripe ==========
# 真实渠道的凭据与套餐配置在管理后台「支付与套餐」，切换渠道在管理后台危险区
# PAYMENT_CHANNEL=
