# ========== 生图网关（OpenAI 兼容，必需） ==========
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# ========== 验证码发信（MOTIF_MAILER=console 默认本地直出） ==========
# console | smtp | resend | sendgrid
MOTIF_MAILER=console
# smtp 渠道（如 QQ 邮箱：smtp.qq.com + 465 + 授权码）
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# resend 渠道
RESEND_API_KEY=
# sendgrid 渠道
SENDGRID_API_KEY=

# ========== 数据位置（可选，默认 apps/web/.data） ==========
# MOTIF_DATA_DIR=
# MOTIF_DB_FILE=

# ========== 本地联调：注册验证码直出（生产不要开启） ==========
MOTIF_EXPOSE_DEV_CODE=
